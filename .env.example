# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env

# --- Superhero API ---
# Free token: sign in with GitHub at https://superheroapi.com/ and copy the access token.
SUPERHERO_API_TOKEN=your-superhero-api-token

# --- LLM provider ---
# Which hosted LLM to use: "gemini" or "nvidia".
LLM_PROVIDER=gemini

# Gemini  -> get a free key at https://aistudio.google.com/apikey   (e.g. LLM_MODEL=gemini-3.6-flash)
# NVIDIA  -> get a free key at https://build.nvidia.com/            (pick any hosted model id for LLM_MODEL)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-3.6-flash
